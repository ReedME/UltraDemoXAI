# Ultrademo environment. Copy this file to .env (which is gitignored) and fill in
# what you need. Everything here is optional - the pipeline runs without a .env,
# it just falls back to a free placeholder voice and no auto-login.
#
#   cp .env.example .env

# --- Narration -------------------------------------------------------------
# Best voice: an xAI API key. ElevenLabs still works. Without either, the
# pipeline uses Piper (free, offline) or the macOS `say` placeholder.
# Unchanged lines are cached, so re-renders never re-bill your quota.
# TTS_PROVIDER=xai|elevenlabs|piper|say forces one engine when more than one is available.
XAI_API_KEY=

# Optional xAI voice. Built-ins include eve (default), iris, altair, ara, rex, sal, leo.
# A custom voice id from the xAI console works too.
# XAI_VOICE_ID=altair
# XAI_LANGUAGE=en
# TTS_PROVIDER=xai

ELEVENLABS_API_KEY=

# Optional ElevenLabs voice tuning (a built-in demo voice is used if unset):
# ELEVENLABS_VOICE_ID=UM3TOcm5kcELI84GFoAz
# ELEVENLABS_STABILITY=0.45

# --- App sign-in (optional) ------------------------------------------------
# For simple form logins, a flow's `setup` can read these instead of you
# pasting credentials into the chat. For SSO or anything with a human check,
# prefer `npm run login -- <profile> <url>` and sign in inside the window.
# APP_EMAIL=
# APP_PASSWORD=
